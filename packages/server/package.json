{
  "name": "@agon/server",
  "version": "0.0.1",
  "description": "Agon control-plane API (Hono, OpenAPI) and workers (pg-boss).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "export-openapi": "tsx src/export-openapi.ts ../sdk/openapi.json"
  },
  "dependencies": {
    "@agon/adapters": "workspace:*",
    "@agon/db": "workspace:*",
    "@agon/engine": "workspace:*",
    "@agon/exporters": "workspace:*",
    "@agon/llm": "workspace:*",
    "@agon/spec": "workspace:*",
    "@agon/stats-client": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.13",
    "pg-boss": "^12.36.0",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  }
}

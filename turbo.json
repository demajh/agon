{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "AGON_LLM_MODE",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "@agon/e2e#test": {
      "dependsOn": [
        "^build",
        "@agon/adapters#test",
        "@agon/db#test"
      ],
      "env": [
        "DATABASE_URL",
        "AGON_LLM_MODE",
        "AGON_SKIP_STATS_TESTS"
      ]
    }
  }
}

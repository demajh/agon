    "@agon/exporters": "workspace:*",
    "@agon/llm": "workspace:*",
    "@agon/spec": "workspace:*",
    "@agon/stats-client": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "pino": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }

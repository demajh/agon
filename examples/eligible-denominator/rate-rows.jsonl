{"id": "r_01", "note": "every row eligible and measured", "stampedAs": "example.rate_row.1", "row": {"metricId": "activation", "variant": "control", "numerator": 3, "denominator": {"raw": 6, "ineligible": [], "eligible": 6, "measured": 6}}, "expectGrade": "RATE_DEFINED", "expectPrinted": "0.50"}
{"id": "r_02", "note": "a real zero: six eligible sessions, none converted", "stampedAs": "example.rate_row.1", "row": {"metricId": "activation", "variant": "treatment", "numerator": 0, "denominator": {"raw": 6, "ineligible": [], "eligible": 6, "measured": 6}}, "expectGrade": "RATE_DEFINED", "expectPrinted": "0.00"}
{"id": "r_03", "note": "same numerator and raw denominator as r_02, but no session finished", "stampedAs": "example.rate_row.1", "row": {"metricId": "activation", "variant": "treatment", "numerator": 0, "denominator": {"raw": 6, "ineligible": [{"reason": "no_outcome", "rows": 6}], "eligible": 0, "measured": 0}}, "expectGrade": "RATE_ELIGIBLE_ZERO", "expectPrinted": "undefined (0 eligible: 6 no_outcome)"}
{"id": "r_04", "note": "six eligible, none read: the value was never recorded", "stampedAs": "example.rate_row.1", "row": {"metricId": "activation", "variant": "treatment", "numerator": 0, "denominator": {"raw": 6, "ineligible": [], "eligible": 6, "measured": 0}}, "expectGrade": "RATE_UNMEASURED", "expectPrinted": "undefined (0 of 6 eligible measured)"}
{"id": "r_05", "note": "two sessions never finished and one eligible session was not read", "stampedAs": "example.rate_row.1", "row": {"metricId": "activation", "variant": "treatment", "numerator": 2, "denominator": {"raw": 8, "ineligible": [{"reason": "no_outcome", "rows": 2}], "eligible": 6, "measured": 5}}, "expectGrade": "RATE_DEFINED", "expectPrinted": "0.40 (1 eligible not measured)"}
{"id": "r_06", "note": "eligible written as null; the stamp counts null as present", "stampedAs": "example.rate_row.1", "row": {"metricId": "activation", "variant": "treatment", "numerator": 0, "denominator": {"raw": 6, "ineligible": [], "eligible": null, "measured": 0}}, "expectGrade": "RATE_ELIGIBLE_MISSING", "expectPrinted": "refused"}
{"id": "r_07", "note": "a producer whose contract records only the numerator and the raw denominator", "stampedAs": "vendor.rate_row.0", "row": {"metricId": "activation", "variant": "treatment", "numerator": 0, "denominator": {"raw": 6}}, "expectGrade": "REQUIRED_SET_NOT_SUPERSET", "expectPrinted": "refused"}

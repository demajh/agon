# Copy to .env for local development. Never commit .env.

# Postgres (matches compose.yaml)
DATABASE_URL=postgres://agon:agon@localhost:5432/agon

# Object storage (MinIO in compose.yaml; any S3-compatible endpoint works)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agon
S3_ACCESS_KEY=agon
S3_SECRET_KEY=agonagon

# API keys accepted by the server: comma-separated "<key>:<role>" (roles: observer, operator, squad)
AGON_API_KEYS=dev-operator-key:operator

# LLM providers. Leave empty and set AGON_LLM_MODE=replay to run from recorded fixtures.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGON_LLM_MODE=live

# Where the CLI writes local run output
AGON_OUT_DIR=./agon-out

{
  "name": "@agon/llm",
  "version": "0.0.1",
  "description": "Provider-agnostic LLM client with structured output, routing, cost accounting, and record/replay.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agon/spec": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.127",
    "@ai-sdk/openai": "^3.0.124",
    "@ai-sdk/openai-compatible": "^2.0.81",
    "ai": "^6.0.300",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pino": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

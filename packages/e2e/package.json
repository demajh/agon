{
  "name": "@agon/e2e",
  "version": "0.0.1",
  "private": true,
  "description": "Integration tests: the real Playwright web adapter driving the real Ledgerly demo app with a scripted LLM.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
